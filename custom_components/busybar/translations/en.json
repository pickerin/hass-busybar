  "services": {
    "draw_text": {
      "name": "Draw text",
      "description": "Draw text on the BUSY Bar display.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Target BUSY Bar (optional if only one is configured)."
        },
        "text": {
          "name": "Text",
          "description": "Text to display."
        },
        "display": {
          "name": "Display",
          "description": "Front (outward) or back (user-facing) display."
        },
        "font": {
          "name": "Font",
          "description": "Font name."
        },
        "color": {
          "name": "Color",
          "description": "Hex color, e.g. #FF0000."
        },
        "x": {
          "name": "X",
          "description": "Horizontal position."
        },
        "y": {
          "name": "Y",
          "description": "Vertical position."
        },
        "align": {
          "name": "Align",
          "description": "Anchor alignment."
        },
        "timeout_ms": {
          "name": "Timeout",
          "description": "Remove the text after this many milliseconds."
        },
        "scroll_rate": {
          "name": "Scroll rate",
          "description": "Scroll speed for long text."
        }
      }
    },
    "clear_display": {
      "name": "Clear display",
      "description": "Remove content drawn via the API.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Target BUSY Bar (optional if only one is configured)."
        }
      }
    },
    "play_audio": {
      "name": "Play audio",
      "description": "Play an uploaded (path) or built-in (stock_path) sound.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Target BUSY Bar (optional if only one is configured)."
        },
        "path": {
          "name": "Path",
          "description": "Path to an uploaded audio asset."
        },
        "stock_path": {
          "name": "Stock path",
          "description": "Name of a built-in sound."
        }
      }
    },
    "stop_audio": {
      "name": "Stop audio",
      "description": "Stop audio playback.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Target BUSY Bar (optional if only one is configured)."
        }
      }
    },
    "press_key": {
      "name": "Press key",
      "description": "Simulate pressing a physical control on the Bar (buttons, mode switch positions).",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Target BUSY Bar (optional if only one is configured)."
        },
        "key": {
          "name": "Key",
          "description": "Key to press: up, down, ok, back, start, busy, custom, off, apps, settings."
        }
      }
    }
  }
