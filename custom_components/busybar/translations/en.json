{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Connect to BUSY Bar",
        "data": {
          "host": "Host (IP address)",
          "api_key": "API password (only if one is set on the Bar)"
        }
      },
      "zeroconf_confirm": {
        "title": "Add BUSY Bar",
        "description": "Add {name} to Home Assistant?"
      },
      "reauth_confirm": {
        "title": "Reauthenticate BUSY Bar",
        "description": "Enter the Bar's HTTP API password (4-10 digits), set in its local web interface: connect the Bar via USB, open http://10.0.4.20, Network tab, enable HTTP API access.",
        "data": {
          "api_key": "API key"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the device",
      "invalid_auth": "Invalid API key"
    },
    "abort": {
      "already_configured": "This BUSY Bar is already configured",
      "cannot_connect": "Cannot connect to the device",
      "reauth_successful": "Reauthentication successful"
    }
  },
  "entity": {
    "sensor": {
      "busy_status": {
        "name": "Busy status",
